# LLM API key (OpenAI or any OpenAI-compatible provider)
OPENAI_API_KEY=sk-your-api-key-here

# Optional: OpenAI-compatible base URL (leave empty for official OpenAI)
# DeepSeek example:
# OPENAI_BASE_URL=https://api.deepseek.com
# OPENAI_MODEL=deepseek-chat
#
# Official OpenAI (needs network access to api.openai.com):
# OPENAI_BASE_URL=
# OPENAI_MODEL=gpt-4o-mini
OPENAI_BASE_URL=
OPENAI_MODEL=gpt-4o-mini

# Optional: Custom data directory (defaults to ~/.db_query)
DB_QUERY_DATA_DIR=~/.db_query

# Logging level (DEBUG, INFO, WARNING, ERROR)
LOG_LEVEL=INFO

# CORS origins (comma-separated, * for all)
CORS_ORIGINS=*
